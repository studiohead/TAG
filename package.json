{
  "name": "test-governance-agent",
  "version": "2.0.0",
  "description": "Enterprise Test Governance Agent — TypeScript / Playwright",
  "main": "dist/agent.js",
  "types": "dist/agent.d.ts",
  "type": "commonjs",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "build:check": "tsc --noEmit",
    "start": "node dist/agent.js",
    "dev": "ts-node src/agent.ts",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest --reporter=verbose",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' 'tests/**/*.ts' --fix",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["test-governance", "playwright", "ci", "agent"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "acorn": "^8.14.0",
    "acorn-walk": "^8.3.4",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/acorn": "^4.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "playwright": "^1.50.0",
    "@playwright/test": "^1.50.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
